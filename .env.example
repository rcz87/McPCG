# CoinGlass API Configuration
COINGLASS_API_KEY="your-api-key-here"
COINGLASS_PLAN="standard"

# Arkham Intel API Configuration (on-chain whale tracking)
# Get your key at: https://intel.arkm.com → Settings → API Keys
ARKHAM_API_KEY="your-arkham-api-key-here"

# Nansen Smart Money API Configuration
# Get your key at: https://app.nansen.ai → Settings → API
NANSEN_API_KEY="your-nansen-api-key-here"

# MCP Server Configuration
MCP_HOST="0.0.0.0"
MCP_PORT=8787

# Security: Bearer token for MCP access control (optional but recommended)
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_AUTH_TOKEN="your-secret-token-here"
